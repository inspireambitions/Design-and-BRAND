# All optional. With no key set the app runs the offline structure checker
# (English only, clearly labelled in the UI) and Arabic answers are declined
# with an explanation rather than scored unfairly.
#
# Set exactly one provider. If both are set, OpenRouter wins.

# Primary provider (approved architecture): OpenRouter.
# Get a key at https://openrouter.ai/keys and add it in
# Vercel → Project → Settings → Environment Variables.
OPENROUTER_API_KEY=

# Which model OpenRouter routes scoring to. Check the exact slug at
# https://openrouter.ai/models — change it here (no code change needed),
# then re-run scripts/measure-consistency.mjs before trusting the new model.
SCORING_MODEL=openai/gpt-5.6

# Alternative provider: direct Anthropic API (claude-opus-5).
ANTHROPIC_API_KEY=
