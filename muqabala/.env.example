# All optional. With no key set the app runs the offline structure checker
# (English only, clearly labelled in the UI) and Arabic answers are declined
# with an explanation rather than scored unfairly.
#
# Provider precedence: direct OpenAI, then OpenRouter, then Anthropic.

# Production primary: direct OpenAI API.
# Create a restricted project key and add it in Vercel Project Settings.
OPENAI_API_KEY=
OPENAI_SCORING_MODEL=gpt-5.6-sol

# Optional fallback provider: OpenRouter.
# Get a key at https://openrouter.ai/keys and add it in
# Vercel → Project → Settings → Environment Variables.
OPENROUTER_API_KEY=

# Which model OpenRouter routes scoring to. Check the exact slug at
# https://openrouter.ai/models — change it here (no code change needed),
# then re-run scripts/measure-consistency.mjs before trusting the new model.
SCORING_MODEL=openai/gpt-5.6-sol

# Reasoning effort for scoring: low / medium / high. Medium is the default;
# benchmark against high with scripts/measure-consistency.mjs before switching.
SCORING_REASONING=medium

# Keep OpenRouter traffic below the account's published/current request limit.
# The current new-account cap is 10 RPM, so the safe default is 9.
OPENROUTER_RPM_LIMIT=9

# Alternative provider: direct Anthropic API (claude-opus-5).
ANTHROPIC_API_KEY=
ANTHROPIC_SCORING_MODEL=claude-opus-5
ENABLE_ANTHROPIC_FALLBACK=false
AI_GLOBAL_CONCURRENCY=100

# Server-only Sentry DSN. Error events are scrubbed in lib/sentry-server.ts;
# transcripts, prompts, request bodies, headers, users and breadcrumbs are removed.
SENTRY_DSN=

# Anonymous usage analytics (PostHog EU). Optional — with no key, no analytics
# run at all. Events are limited to the explicit calls in lib/analytics.ts:
# never transcripts, typed job titles, video, audio, or personal data.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# REQUIRED in production. Signs the rubric for interviews generated from a
# pasted job advert, so the browser can carry it to the scorer without being
# able to author it. Generate with:  openssl rand -base64 48
# If unset, a key is derived from the provider key as a TEMPORARY fallback —
# workable, but rotating the provider key then invalidates live interviews
# mid-session. Set a dedicated secret before real traffic.
INTERVIEW_SECRET=

# Generation settings, kept separate from scoring so they can be tuned apart.
INTERVIEW_MODEL=
INTERVIEW_REASONING=medium
# Best-effort per-instance brake on generation, NOT a deployment-wide cap.
# A real ceiling needs Vercel Firewall or shared storage.
INTERVIEW_DAILY_LIMIT=400

# Shared deployment-wide rate limits for Vercel. Create one Redis database in
# Upstash and copy its REST credentials here and into Vercel. Both are
# server-only. Never use the read-only token because rate limiting writes keys.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Account, cross-device resume and private report storage.
# Use a new Muqabala Supabase project. Do not reuse an unrelated project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose this value through a NEXT_PUBLIC variable.
SUPABASE_SECRET_KEY=

# Canonical origin used for email links and strict same-origin checks.
APP_ORIGIN=https://trymuqabala.com

# Required for the daily employer-video retention cleanup route. Generate a
# long random value and keep it server-only. Vercel Cron sends it as a bearer
# token when calling /api/cron/screening-cleanup.
CRON_SECRET=

# Gulf interview guides (Sanity). These IDs are public.
# The app reads published guides on the server. Never put a write token in NEXT_PUBLIC_*.
NEXT_PUBLIC_SANITY_PROJECT_ID=rnjajs8i
NEXT_PUBLIC_SANITY_DATASET=production
# Server-only. Used by `npm run studio` and `npm run guides:seed`. Not used by the public site.
SANITY_API_WRITE_TOKEN=

# BabyLoveGrowth sends an authenticated POST to /api/integrations/babylovegrowth.
# Generate a long random value and use the same value in BabyLoveGrowth and Vercel.
BABYLOVEGROWTH_WEBHOOK_SECRET=
# Safer default: articles arrive in Sanity as drafts. Set to published only after review.
BABYLOVEGROWTH_PUBLISH_MODE=draft
