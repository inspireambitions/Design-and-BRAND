# Roadmap generation. Without this the deterministic engine in lib/engine.ts
# produces the report, so the tool works with no key at all.
ANTHROPIC_API_KEY=

# Email gate. Required for the gate to actually deliver — the sending domain
# must be verified in Resend first. Without it, addresses are logged and dropped.
RESEND_API_KEY=
EMAIL_FROM="Inspire Ambitions <roadmap@inspireambitions.com>"
